<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Semantic roles from BRAND.md. Windows contrast overrides the brand palette. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <Color x:Key="TemhaloHaloColor">#7CE8CD</Color>
      <Color x:Key="TemhaloEchoColor">#B9B2FF</Color>
      <Color x:Key="TemhaloCanvasColor">#0D1218</Color>
      <Color x:Key="TemhaloSurfaceColor">#151D26</Color>
      <Color x:Key="TemhaloRaisedColor">#1D2935</Color>
      <Color x:Key="TemhaloTextColor">#F1F5F9</Color>
      <Color x:Key="TemhaloTextSecondaryColor">#B4C1CF</Color>
      <Color x:Key="TemhaloTextMutedColor">#96A7B9</Color>
      <Color x:Key="TemhaloDecorativeStrokeColor">#2C3C4C</Color>
      <Color x:Key="TemhaloControlStrokeColor">#687E94</Color>
      <Color x:Key="TemhaloSuccessColor">#75D8A5</Color>
      <Color x:Key="TemhaloWarningColor">#F6C66D</Color>
      <Color x:Key="TemhaloErrorColor">#FF8D9A</Color>
      <Color x:Key="TemhaloHoverColor">#9AEFD9</Color>
      <Color x:Key="TemhaloPressedColor">#5DCEB2</Color>
      <Color x:Key="TemhaloOnBrandColor">#0D1218</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <Color x:Key="TemhaloHaloColor">{ThemeResource SystemColorHighlightColor}</Color>
      <Color x:Key="TemhaloEchoColor">{ThemeResource SystemColorWindowTextColor}</Color>
      <Color x:Key="TemhaloCanvasColor">{ThemeResource SystemColorWindowColor}</Color>
      <Color x:Key="TemhaloSurfaceColor">{ThemeResource SystemColorWindowColor}</Color>
      <Color x:Key="TemhaloRaisedColor">{ThemeResource SystemColorButtonFaceColor}</Color>
      <Color x:Key="TemhaloTextColor">{ThemeResource SystemColorWindowTextColor}</Color>
      <Color x:Key="TemhaloTextSecondaryColor">{ThemeResource SystemColorWindowTextColor}</Color>
      <Color x:Key="TemhaloTextMutedColor">{ThemeResource SystemColorWindowTextColor}</Color>
      <Color x:Key="TemhaloDecorativeStrokeColor">{ThemeResource SystemColorWindowTextColor}</Color>
      <Color x:Key="TemhaloControlStrokeColor">{ThemeResource SystemColorButtonTextColor}</Color>
      <Color x:Key="TemhaloSuccessColor">{ThemeResource SystemColorWindowTextColor}</Color>
      <Color x:Key="TemhaloWarningColor">{ThemeResource SystemColorWindowTextColor}</Color>
      <Color x:Key="TemhaloErrorColor">{ThemeResource SystemColorWindowTextColor}</Color>
      <Color x:Key="TemhaloHoverColor">{ThemeResource SystemColorHighlightColor}</Color>
      <Color x:Key="TemhaloPressedColor">{ThemeResource SystemColorHighlightColor}</Color>
      <Color x:Key="TemhaloOnBrandColor">{ThemeResource SystemColorHighlightTextColor}</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <SolidColorBrush x:Key="TemhaloCanvasBrush" Color="{ThemeResource TemhaloCanvasColor}" />
  <SolidColorBrush x:Key="TemhaloSurfaceBrush" Color="{ThemeResource TemhaloSurfaceColor}" />
  <SolidColorBrush x:Key="TemhaloRaisedBrush" Color="{ThemeResource TemhaloRaisedColor}" />
  <SolidColorBrush x:Key="TemhaloTextBrush" Color="{ThemeResource TemhaloTextColor}" />
  <SolidColorBrush x:Key="TemhaloSecondaryBrush" Color="{ThemeResource TemhaloTextSecondaryColor}" />
  <SolidColorBrush x:Key="TemhaloMutedBrush" Color="{ThemeResource TemhaloTextMutedColor}" />
  <SolidColorBrush x:Key="TemhaloRuleBrush" Color="{ThemeResource TemhaloDecorativeStrokeColor}" />
  <SolidColorBrush x:Key="TemhaloControlBrush" Color="{ThemeResource TemhaloControlStrokeColor}" />
  <SolidColorBrush x:Key="TemhaloHaloBrush" Color="{ThemeResource TemhaloHaloColor}" />
  <SolidColorBrush x:Key="TemhaloEchoBrush" Color="{ThemeResource TemhaloEchoColor}" />
  <SolidColorBrush x:Key="TemhaloSuccessBrush" Color="{ThemeResource TemhaloSuccessColor}" />
  <SolidColorBrush x:Key="TemhaloWarningBrush" Color="{ThemeResource TemhaloWarningColor}" />
  <SolidColorBrush x:Key="TemhaloErrorBrush" Color="{ThemeResource TemhaloErrorColor}" />
  <SolidColorBrush x:Key="TemhaloOnBrandBrush" Color="{ThemeResource TemhaloOnBrandColor}" />
  <SolidColorBrush x:Key="TemhaloHoverBrush" Color="{ThemeResource TemhaloHoverColor}" />
  <SolidColorBrush x:Key="TemhaloPressedBrush" Color="{ThemeResource TemhaloPressedColor}" />
</ResourceDictionary>
