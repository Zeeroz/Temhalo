<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="TemhaloUiFont">ms-appx:///Assets/Fonts/Inter-Variable.ttf#Inter</FontFamily>
  <FontFamily x:Key="TemhaloTitleFont">ms-appx:///Assets/Fonts/SpaceGrotesk-Variable.ttf#Space Grotesk</FontFamily>
  <FontFamily x:Key="TemhaloMonoFont">ms-appx:///Assets/Fonts/JetBrainsMono-Variable.ttf#JetBrains Mono</FontFamily>
  <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Inter-Variable.ttf#Inter</FontFamily>
  <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
  <x:Double x:Key="ComboBoxThemeMinHeight">44</x:Double>
  <StaticResource x:Key="AccentFillColorDefaultBrush" ResourceKey="TemhaloHaloBrush" />
  <StaticResource x:Key="AccentFillColorSecondaryBrush" ResourceKey="TemhaloHoverBrush" />
  <StaticResource x:Key="AccentFillColorTertiaryBrush" ResourceKey="TemhaloPressedBrush" />
  <StaticResource x:Key="TextOnAccentFillColorPrimaryBrush" ResourceKey="TemhaloOnBrandBrush" />
  <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="TemhaloHaloBrush" />
  <StaticResource x:Key="SystemControlHighlightAccentBrush" ResourceKey="TemhaloHaloBrush" />
  <StaticResource x:Key="FocusVisualPrimaryBrush" ResourceKey="TemhaloHaloBrush" />
  <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="TemhaloHaloBrush" />
  <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="TemhaloHaloBrush" />
  <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="TemhaloHaloBrush" />
  <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="TemhaloHaloBrush" />
  <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="TemhaloHaloBrush" />
  <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="TemhaloHoverBrush" />
  <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="TemhaloPressedBrush" />
  <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TemhaloOnBrandBrush" />
  <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TemhaloOnBrandBrush" />
  <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TemhaloOnBrandBrush" />
  <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="TemhaloHaloBrush" />
  <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="TemhaloHoverBrush" />
  <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="TemhaloPressedBrush" />
  <StaticResource x:Key="ToggleSwitchKnobFillOn" ResourceKey="TemhaloOnBrandBrush" />
  <StaticResource x:Key="ToggleSwitchKnobFillOnPointerOver" ResourceKey="TemhaloOnBrandBrush" />
  <StaticResource x:Key="ToggleSwitchKnobFillOnPressed" ResourceKey="TemhaloOnBrandBrush" />
  <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="TemhaloHaloBrush" />
  <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="TemhaloHoverBrush" />
  <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="TemhaloPressedBrush" />
  <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="TemhaloHaloBrush" />
  <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="TemhaloHoverBrush" />
  <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" ResourceKey="TemhaloPressedBrush" />
  <Thickness x:Key="TemhaloPagePadding">28,24,28,28</Thickness>
  <Thickness x:Key="TemhaloPagePaddingCompact">20,20,20,24</Thickness>
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TemhaloUiFont}" />
    <Setter Property="FontSize" Value="14" /><Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{ThemeResource TemhaloTextBrush}" />
  </Style>
  <Style x:Key="TemhaloTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TemhaloTitleFont}" />
    <Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="{ThemeResource TemhaloTextBrush}" />
  </Style>
  <Style x:Key="TemhaloSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource TemhaloTitle}">
    <Setter Property="FontSize" Value="18" />
  </Style>
  <Style x:Key="TemhaloCaption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TemhaloUiFont}" /><Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="{ThemeResource TemhaloMutedBrush}" />
  </Style>
  <Style x:Key="TemhaloMono" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TemhaloMonoFont}" /><Setter Property="FontSize" Value="14" />
    <Setter Property="Typography.StandardLigatures" Value="False" />
    <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="{ThemeResource TemhaloTextBrush}" />
  </Style>
  <Style x:Key="TemhaloPanel" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource TemhaloSurfaceBrush}" /><Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="24" /><Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style TargetType="Button">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontFamily" Value="{StaticResource TemhaloUiFont}" /><Setter Property="FontWeight" Value="Medium" />
    <Setter Property="MinHeight" Value="44" /><Setter Property="Padding" Value="16,10" />
    <Setter Property="Background" Value="{ThemeResource TemhaloRaisedBrush}" /><Setter Property="Foreground" Value="{ThemeResource TemhaloTextBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource TemhaloControlBrush}" />
  </Style>
  <Style x:Key="TemhaloPrimaryButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontFamily" Value="{StaticResource TemhaloUiFont}" /><Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="44" /><Setter Property="Padding" Value="20,10" />
    <Setter Property="Background" Value="{ThemeResource TemhaloHaloBrush}" /><Setter Property="Foreground" Value="{ThemeResource TemhaloOnBrandBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource TemhaloHaloBrush}" />
  </Style>
  <Style TargetType="ToggleButton">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontFamily" Value="{StaticResource TemhaloUiFont}" /><Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="12,10" /><Setter Property="MinWidth" Value="60" />
    <Setter Property="BorderBrush" Value="{ThemeResource TemhaloControlBrush}" />
  </Style>
  <Style x:Key="TemhaloLinkButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="FontFamily" Value="{StaticResource TemhaloUiFont}"/>
    <Setter Property="Foreground" Value="{ThemeResource TemhaloHaloBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="Padding" Value="0,8"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <Style x:Key="TemhaloProviderButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="FontFamily" Value="{StaticResource TemhaloUiFont}"/>
    <Setter Property="Padding" Value="20,18"/>
    <Setter Property="MinHeight" Value="80"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Background" Value="{ThemeResource TemhaloSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource TemhaloControlBrush}"/>
  </Style>
  <Style x:Key="TemhaloStepButton" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontFamily" Value="{StaticResource TemhaloUiFont}"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="Padding" Value="16,10"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontFamily" Value="{StaticResource TemhaloUiFont}" /><Setter Property="MinHeight" Value="44" />
    <Setter Property="Background" Value="{ThemeResource TemhaloCanvasBrush}" /><Setter Property="BorderBrush" Value="{ThemeResource TemhaloControlBrush}" />
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontFamily" Value="{StaticResource TemhaloUiFont}" /><Setter Property="MinHeight" Value="44" />
    <Setter Property="Background" Value="{ThemeResource TemhaloCanvasBrush}" /><Setter Property="BorderBrush" Value="{ThemeResource TemhaloControlBrush}" />
  </Style>
  <Style TargetType="NumberBox">
    <Setter Property="FontFamily" Value="{StaticResource TemhaloMonoFont}" /><Setter Property="MinHeight" Value="44" />
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource TemhaloUiFont}" />
    <Setter Property="CornerRadius" Value="8" /><Setter Property="MinHeight" Value="44" />
    <Setter Property="BorderBrush" Value="{ThemeResource TemhaloControlBrush}" />
  </Style>
</ResourceDictionary>
