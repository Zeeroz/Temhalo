<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Temhalo.App.Controls" x:Class="Temhalo.App.Views.DashboardPage" Background="{ThemeResource TemhaloCanvasBrush}">
  <Page.Resources>
    <StaticResource x:Key="SliderTrackFill" ResourceKey="TemhaloControlBrush"/>
    <StaticResource x:Key="SliderTrackValueFill" ResourceKey="TemhaloHaloBrush"/>
    <StaticResource x:Key="SliderThumbBackground" ResourceKey="TemhaloHaloBrush"/>
  </Page.Resources>
  <Grid x:Name="LayoutRoot" RowDefinitions="Auto,*" SizeChanged="LayoutChanged">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WidthStates">
        <VisualState x:Name="WideLayout">
          <VisualState.Setters>
            <Setter Target="MainContent.Padding" Value="28,24,28,28"/>
            <Setter Target="DelayPanel.Padding" Value="28"/>
            <Setter Target="CurrentValue.FontSize" Value="48"/>
            <Setter Target="DelayMeasure.BorderThickness" Value="0,0,1,0"/>
            <Setter Target="DelayMeasure.Padding" Value="0,0,28,0"/>
            <Setter Target="DelayControls.Margin" Value="28,0,0,0"/>
            <Setter Target="DelayControls.(Grid.Column)" Value="1"/>
            <Setter Target="DelayControls.(Grid.Row)" Value="0"/>
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="CompactLayout">
          <VisualState.Setters>
            <Setter Target="MainContent.Padding" Value="20,20,20,24"/>
            <Setter Target="DelayPanel.Padding" Value="20"/>
            <Setter Target="CurrentValue.FontSize" Value="40"/>
            <Setter Target="DelayMeasure.BorderThickness" Value="0,0,0,1"/>
            <Setter Target="DelayMeasure.Padding" Value="0,0,0,24"/>
            <Setter Target="DelayControls.Margin" Value="0,24,0,0"/>
            <Setter Target="DelayControls.(Grid.Column)" Value="0"/>
            <Setter Target="DelayControls.(Grid.Row)" Value="1"/>
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid x:Name="HeaderGrid" Padding="20,8,28,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" BorderBrush="{ThemeResource TemhaloRuleBrush}" BorderThickness="0,0,0,1">
      <NavigationView x:Name="Navigation" PaneDisplayMode="Top" Height="56" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsTitleBarAutoPaddingEnabled="False" AlwaysShowHeader="False" SelectionChanged="NavigationChanged" Background="{ThemeResource TemhaloCanvasBrush}">
        <NavigationView.Resources>
          <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource TemhaloHaloColor}"/>
          <Thickness x:Key="TopNavigationViewItemContentMargin">8,0,8,0</Thickness>
          <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
          <Thickness x:Key="TopNavigationViewContentGridBorderThickness">0</Thickness>
        </NavigationView.Resources>
        <NavigationView.MenuItems>
          <NavigationViewItem Content="Direct" Tag="direct" AutomationProperties.AutomationId="DirectTab"/>
          <NavigationViewItem Content="Diffusion" Tag="diffusion" AutomationProperties.AutomationId="DiffusionTab"/>
          <NavigationViewItem Content="Réglages" Tag="settings" AutomationProperties.AutomationId="SettingsTab"/>
        </NavigationView.MenuItems>
      </NavigationView>
      <local:WrapPanel x:Name="SessionCommands" Grid.Column="1" Spacing="16" VerticalAlignment="Center">
        <TextBlock x:Name="SessionLabel" Style="{StaticResource TemhaloCaption}" VerticalAlignment="Center"/>
        <TextBlock x:Name="LiveClock" Text="{x:Bind Vm.LiveDuration, Mode=OneWay}" Style="{StaticResource TemhaloMono}" FontSize="12" VerticalAlignment="Center"/>
        <Button x:Name="StartStopButton" Content="Démarrer le relais" Click="StartStopClicked" AutomationProperties.AutomationId="StartStop"/>
      </local:WrapPanel>
    </Grid>
    <ScrollViewer x:Name="MainScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
      <StackPanel x:Name="MainContent" Padding="28,24,28,28" Spacing="24">
        <InfoBar x:Name="Notice" IsOpen="False" Visibility="Collapsed" Severity="Error" IsClosable="True" Closed="NoticeClosed"/>
        <StackPanel x:Name="DashboardView" Spacing="24">
          <StackPanel Spacing="8">
            <TextBlock Text="Direct" Style="{StaticResource TemhaloTitle}" AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="Le délai de votre diffusion, au même endroit." Foreground="{ThemeResource TemhaloSecondaryBrush}"/>
          </StackPanel>
          <Border x:Name="DirectEmpty" Style="{StaticResource TemhaloPanel}" Visibility="Collapsed">
            <StackPanel Spacing="16">
              <TextBlock x:Name="DirectEmptyTitle" Text="Préparez votre première diffusion." Style="{StaticResource TemhaloSectionTitle}"/>
              <TextBlock x:Name="DirectEmptyDescription" Text="Ajoutez une plateforme, puis reliez OBS. Vos choix seront conservés pour vos prochains lives." Foreground="{ThemeResource TemhaloSecondaryBrush}"/>
              <Button Content="Configurer ma diffusion →" Click="ConfigureClicked" HorizontalAlignment="Left" Style="{StaticResource TemhaloPrimaryButton}"/>
            </StackPanel>
          </Border>
          <InfoBar x:Name="RelayHint" IsOpen="False" IsClosable="False" Visibility="Collapsed" Severity="Informational" AutomationProperties.AutomationId="RelayHint">
            <InfoBar.ActionButton>
              <Button x:Name="RelayHintButton" Content="Revoir le guide OBS" Click="RelayHintClicked"/>
            </InfoBar.ActionButton>
          </InfoBar>
          <ProgressBar x:Name="PreparationProgress" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="Préparation du relais"/>
          <StackPanel x:Name="DirectContent" Spacing="24">
            <Border x:Name="DelayPanel" Style="{StaticResource TemhaloPanel}">
              <Grid x:Name="DelayGrid" ColumnDefinitions="*,1.9*" RowDefinitions="Auto,Auto">
                <Border x:Name="DelayMeasure" BorderBrush="{ThemeResource TemhaloRuleBrush}" BorderThickness="0,0,1,0" Padding="0,0,28,0">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Délai actuel" Foreground="{ThemeResource TemhaloSecondaryBrush}"/>
                    <TextBlock x:Name="CurrentValue" Text="{x:Bind Vm.CurrentText, Mode=OneWay}" FontFamily="{StaticResource TemhaloMonoFont}" FontSize="48" FontWeight="Medium" Typography.StandardLigatures="False" AutomationProperties.AutomationId="CurrentDelay"/>
                    <local:WrapPanel Spacing="8">
                      <TextBlock Text="Cible appliquée" Foreground="{ThemeResource TemhaloSecondaryBrush}" VerticalAlignment="Center"/>
                      <TextBlock Text="{x:Bind Vm.TargetText, Mode=OneWay}" FontFamily="{StaticResource TemhaloMonoFont}" FontSize="18" Foreground="{ThemeResource TemhaloEchoBrush}" AutomationProperties.AutomationId="TargetDelay"/>
                    </local:WrapPanel>
                    <TextBlock Text="{x:Bind Vm.TransitionText, Mode=OneWay}" Style="{StaticResource TemhaloCaption}" AutomationProperties.LiveSetting="Polite"/>
                  </StackPanel>
                </Border>
                <StackPanel x:Name="DelayControls" Grid.Column="1" Margin="28,0,0,0" Spacing="16">
                  <TextBlock Text="Choisir le délai" Style="{StaticResource TemhaloSectionTitle}"/>
                  <ContentControl IsEnabled="{x:Bind Vm.CanEdit, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                    <local:WrapPanel x:Name="DirectPresets" Spacing="8"/>
                  </ContentControl>
                  <StackPanel x:Name="CustomDelayEditor" Visibility="Collapsed" Spacing="12">
                    <Border Height="1" Background="{ThemeResource TemhaloRuleBrush}"/>
                    <local:WrapPanel Spacing="12">
                      <NumberBox x:Name="DelayNumber" Header="Délai en secondes" Value="{x:Bind Vm.NumberDraft, Mode=TwoWay}" ValidationMode="Disabled" SpinButtonPlacementMode="Inline" SmallChange="1" LargeChange="10" Width="164" IsEnabled="{x:Bind Vm.CanEdit, Mode=OneWay}" AutomationProperties.Name="Nouvelle cible en secondes, entier de 0 à 300" AutomationProperties.AutomationId="DelayNumber"/>
                      <Button Content="Appliquer" Command="{x:Bind Vm.ApplyCommand}" VerticalAlignment="Bottom" Style="{StaticResource TemhaloPrimaryButton}" AutomationProperties.AutomationId="ApplyDelay"/>
                    </local:WrapPanel>
                    <TextBlock Text="{x:Bind Vm.DraftError, Mode=OneWay}" Foreground="{ThemeResource TemhaloErrorBrush}" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
                    <Slider x:Name="DelaySlider" Minimum="0" Maximum="300" StepFrequency="1" SmallChange="1" LargeChange="10" MinHeight="44" Value="{x:Bind Vm.SliderDraft, Mode=TwoWay}" IsEnabled="{x:Bind Vm.CanEdit, Mode=OneWay}" AutomationProperties.Name="Nouvelle cible de délai en secondes" AutomationProperties.AutomationId="DelaySlider"/>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="0 s" Style="{StaticResource TemhaloCaption}"/>
                      <TextBlock Grid.Column="1" Text="300 s · 5 min" Style="{StaticResource TemhaloCaption}"/>
                    </Grid>
                  </StackPanel>
                  <TextBlock Text="Les presets s’appliquent au clic. Une durée personnalisée se valide avec Appliquer." Style="{StaticResource TemhaloCaption}"/>
                </StackPanel>
              </Grid>
            </Border>
            <TextBlock Text="Le délai affiché est celui de Temhalo. La plateforme et le lecteur ajoutent leur propre latence." Style="{StaticResource TemhaloCaption}"/>
            <StackPanel Spacing="12">
              <local:SettingRow>
                <TextBlock Text="Votre diffusion" Style="{StaticResource TemhaloSectionTitle}"/>
                <Button Content="Gérer les plateformes →" Click="ManagePlatformsClicked" Style="{StaticResource TemhaloLinkButton}"/>
              </local:SettingRow>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12,0,16" BorderBrush="{ThemeResource TemhaloRuleBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="OBS · Source du flux"/>
                <TextBlock x:Name="IngestState" Grid.Column="1" Style="{StaticResource TemhaloCaption}"/>
              </Grid>
              <StackPanel x:Name="DirectOutputs"/>
            </StackPanel>
            <local:SettingRow>
              <TextBlock Text="{x:Bind Vm.HistoryText, Mode=OneWay}" Style="{StaticResource TemhaloCaption}" AutomationProperties.AutomationId="ReplayHistory"/>
              <Button Content="Détails et diagnostic →" Click="ShowJournalClicked" Style="{StaticResource TemhaloLinkButton}"/>
            </local:SettingRow>
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="DestinationView" Visibility="Collapsed" Spacing="24">
          <local:SettingRow>
            <StackPanel Spacing="8">
              <TextBlock x:Name="DiffusionTitle" Text="Préparer votre diffusion" Style="{StaticResource TemhaloTitle}" AutomationProperties.HeadingLevel="Level1"/>
              <TextBlock x:Name="DiffusionDescription" Text="Trois étapes. Vos choix seront conservés pour vos prochains lives." Foreground="{ThemeResource TemhaloSecondaryBrush}"/>
            </StackPanel>
            <Button x:Name="ReviewObsButton" Content="Revoir les réglages OBS" Click="ObsGuideClicked"/>
          </local:SettingRow>
          <local:AdaptiveColumns x:Name="SetupSteps" Columns="3" Threshold="0" Spacing="8">
            <local:AdaptiveColumns.Resources>
              <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent"/>
              <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent"/>
              <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent"/>
              <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent"/>
              <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent"/>
              <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TemhaloTextBrush"/>
              <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TemhaloTextBrush"/>
              <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TemhaloTextBrush"/>
            </local:AdaptiveColumns.Resources>
            <ToggleButton x:Name="PlatformsStep" Tag="1" Click="SetupStepClicked" Style="{StaticResource TemhaloStepButton}" AutomationProperties.AutomationId="PlatformsStep" AutomationProperties.Name="1 · Plateforme">
              <Grid x:Name="PlatformsStepLayout" ColumnDefinitions="28,*" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                <Border x:Name="PlatformsStepDot" HorizontalAlignment="Left" Width="28" Height="28" CornerRadius="14" BorderThickness="1" BorderBrush="{ThemeResource TemhaloControlBrush}" VerticalAlignment="Center">
                  <TextBlock x:Name="PlatformsStepNumber" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                </Border>
                <TextBlock x:Name="PlatformsStepLabel" Grid.Column="1" Text="Plateforme" VerticalAlignment="Center"/>
              </Grid>
            </ToggleButton>
            <ToggleButton x:Name="ObsStep" Tag="2" Click="SetupStepClicked" Style="{StaticResource TemhaloStepButton}" AutomationProperties.Name="2 · Réglages OBS">
              <Grid x:Name="ObsStepLayout" ColumnDefinitions="28,*" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                <Border x:Name="ObsStepDot" HorizontalAlignment="Left" Width="28" Height="28" CornerRadius="14" BorderThickness="1" BorderBrush="{ThemeResource TemhaloControlBrush}" VerticalAlignment="Center">
                  <TextBlock x:Name="ObsStepNumber" Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                </Border>
                <TextBlock x:Name="ObsStepLabel" Grid.Column="1" Text="Réglages OBS" VerticalAlignment="Center"/>
              </Grid>
            </ToggleButton>
            <ToggleButton x:Name="LaunchStep" Tag="3" Click="SetupStepClicked" Style="{StaticResource TemhaloStepButton}" AutomationProperties.Name="3 · Démarrage">
              <Grid x:Name="LaunchStepLayout" ColumnDefinitions="28,*" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                <Border x:Name="LaunchStepDot" HorizontalAlignment="Left" Width="28" Height="28" CornerRadius="14" BorderThickness="1" BorderBrush="{ThemeResource TemhaloControlBrush}" VerticalAlignment="Center">
                  <TextBlock x:Name="LaunchStepNumber" Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                </Border>
                <TextBlock x:Name="LaunchStepLabel" Grid.Column="1" Text="Démarrage" VerticalAlignment="Center"/>
              </Grid>
            </ToggleButton>
          </local:AdaptiveColumns>
          <StackPanel x:Name="PlatformsPanel" Spacing="24">
            <StackPanel Spacing="8">
              <TextBlock x:Name="PlatformsTitle" Text="Où souhaitez-vous diffuser ?" Style="{StaticResource TemhaloSectionTitle}"/>
              <TextBlock Text="Commencez avec une plateforme. Vous pourrez en ajouter jusqu’à quatre." Foreground="{ThemeResource TemhaloSecondaryBrush}"/>
            </StackPanel>
            <ContentControl x:Name="DestinationFields" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="24">
                <ContentControl x:Name="SavedDestinations" HorizontalContentAlignment="Stretch">
                  <StackPanel x:Name="DestinationsList"/>
                </ContentControl>
                <ContentControl x:Name="ProviderChoices" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="20">
                    <local:AdaptiveColumns x:Name="EmptyPlatforms" Columns="3" Threshold="800" Spacing="12">
                      <Button Tag="0" Click="ChoosePlatformClicked" Style="{StaticResource TemhaloProviderButton}" AutomationProperties.Name="Ajouter Twitch">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Twitch" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TwitchMethod" Text="Connecter votre compte" Style="{StaticResource TemhaloCaption}"/>
                          </StackPanel>
                          <FontIcon Grid.Column="1" Glyph="" FontSize="16" VerticalAlignment="Center"/>
                        </Grid>
                      </Button>
                      <Button Tag="1" Click="ChoosePlatformClicked" Style="{StaticResource TemhaloProviderButton}" AutomationProperties.Name="Ajouter YouTube">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                          <StackPanel Spacing="4">
                            <TextBlock Text="YouTube" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="YouTubeMethod" Text="Utiliser une clé de diffusion" Style="{StaticResource TemhaloCaption}"/>
                          </StackPanel>
                          <FontIcon Grid.Column="1" Glyph="" FontSize="16" VerticalAlignment="Center"/>
                        </Grid>
                      </Button>
                      <Button Tag="2" Click="ChoosePlatformClicked" Style="{StaticResource TemhaloProviderButton}" AutomationProperties.Name="Ajouter Kick">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Kick" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="KickMethod" Text="Utiliser une clé de diffusion" Style="{StaticResource TemhaloCaption}"/>
                          </StackPanel>
                          <FontIcon Grid.Column="1" Glyph="" FontSize="16" VerticalAlignment="Center"/>
                        </Grid>
                      </Button>
                    </local:AdaptiveColumns>
                    <ComboBox x:Name="OtherProvider" Header="Autre plateforme" PlaceholderText="Choisir…" HorizontalAlignment="Left" MinWidth="220" SelectionChanged="OtherProviderChanged">
                      <ComboBoxItem Content="TikTok" Tag="4"/>
                      <ComboBoxItem Content="Facebook" Tag="5"/>
                      <ComboBoxItem Content="Restream" Tag="6"/>
                      <ComboBoxItem Content="Serveur RTMP personnalisé" Tag="3"/>
                    </ComboBox>
                  </StackPanel>
                </ContentControl>
                <Border x:Name="EditorContainer" Visibility="Collapsed" Style="{StaticResource TemhaloPanel}">
                  <StackPanel Spacing="20">
                    <TextBlock x:Name="EditorTitle" Style="{StaticResource TemhaloSectionTitle}"/>
                    <ContentControl x:Name="PlatformEditorHost" HorizontalContentAlignment="Stretch"/>
                    <local:WrapPanel Spacing="8">
                      <Button x:Name="SavePlatformButton" Content="Ajouter la plateforme" Click="SavePlatformClicked" Style="{StaticResource TemhaloPrimaryButton}"/>
                      <Button Content="Annuler" Click="CancelPlatformClicked"/>
                    </local:WrapPanel>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="PlatformLimit" Text="Vous avez atteint la limite de quatre destinations." Style="{StaticResource TemhaloCaption}" Visibility="Collapsed"/>
              </StackPanel>
            </ContentControl>
            <TextBlock x:Name="DestinationHelp" Style="{StaticResource TemhaloCaption}"/>
            <local:SettingRow x:Name="PlatformsActions">
              <TextBlock Text="Toutes les destinations activées reçoivent le même délai." Style="{StaticResource TemhaloCaption}"/>
              <Button x:Name="PlatformsNext" Content="Continuer vers OBS →" Click="PlatformsNextClicked" Style="{StaticResource TemhaloPrimaryButton}"/>
            </local:SettingRow>
          </StackPanel>
          <StackPanel x:Name="ObsPanel" Spacing="24" Visibility="Collapsed">
            <StackPanel Spacing="8">
              <TextBlock Text="Reliez OBS à Temhalo." Style="{StaticResource TemhaloSectionTitle}"/>
              <TextBlock Text="Ces deux valeurs se renseignent une seule fois dans votre profil OBS." Foreground="{ThemeResource TemhaloSecondaryBrush}"/>
            </StackPanel>
            <Border Style="{StaticResource TemhaloPanel}">
              <local:AdaptiveColumns Spacing="32">
                <StackPanel Spacing="16">
                  <TextBlock Text="Dans les paramètres d’OBS" Style="{StaticResource TemhaloSectionTitle}"/>
                  <TextBlock Text="1. Ouvrez Paramètres → Stream (flux)."/>
                  <TextBlock Text="2. Dans Service, choisissez Personnalisé."/>
                  <TextBlock Text="3. Collez le serveur et la clé locale, puis validez."/>
                  <TextBlock Text="Vos clés Twitch, YouTube ou Kick restent dans Temhalo. Dans OBS, utilisez uniquement la clé locale stream." Style="{StaticResource TemhaloCaption}"/>
                </StackPanel>
                <StackPanel Spacing="20">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Serveur OBS" Style="{StaticResource TemhaloCaption}"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Text="rtmp://127.0.0.1:1935/live" Style="{StaticResource TemhaloMono}" IsTextSelectionEnabled="True" VerticalAlignment="Center"/>
                      <Button Grid.Column="1" Content="Copier" Tag="rtmp://127.0.0.1:1935/live" Click="CopyObsValueClicked" AutomationProperties.Name="Copier le serveur OBS"/>
                    </Grid>
                  </StackPanel>
                  <StackPanel Spacing="8">
                    <TextBlock Text="Clé locale OBS" Style="{StaticResource TemhaloCaption}"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Text="stream" Style="{StaticResource TemhaloMono}" IsTextSelectionEnabled="True" VerticalAlignment="Center"/>
                      <Button Grid.Column="1" Content="Copier" Tag="stream" Click="CopyObsValueClicked" AutomationProperties.Name="Copier la clé locale OBS"/>
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </local:AdaptiveColumns>
            </Border>
            <Expander Header="Réglages vidéo et audio à vérifier" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <TextBlock Text="Vidéo H.264 · Audio AAC · Débit constant (CBR) · Intervalle d’images clés : 1 seconde. Désactivez le délai de stream d’OBS. Le débit et la résolution doivent être acceptés par toutes vos plateformes."/>
            </Expander>
            <CheckBox x:Name="ObsAcknowledged" Visibility="Collapsed" IsTabStop="False"/>
            <TextBlock Text="Le bouton confirme que vous avez suivi le guide. La connexion sera vérifiée à la réception du flux." Style="{StaticResource TemhaloCaption}"/>
            <local:SettingRow>
              <Button Content="Retour" Tag="1" Click="SetupStepClicked" HorizontalAlignment="Left"/>
              <Button x:Name="ObsNext" Content="J’ai terminé dans OBS →" Click="ObsNextClicked" Style="{StaticResource TemhaloPrimaryButton}"/>
            </local:SettingRow>
          </StackPanel>
          <StackPanel x:Name="LaunchPanel" Spacing="24" Visibility="Collapsed">
            <TextBlock Text="Prêt côté Temhalo." Style="{StaticResource TemhaloSectionTitle}"/>
            <TextBlock x:Name="LaunchHelp" Text="Démarrez le relais, puis lancez votre stream dans OBS."/>
            <Border Style="{StaticResource TemhaloPanel}">
              <StackPanel Spacing="16">
                <TextBlock x:Name="RouteDestination" Style="{StaticResource TemhaloSectionTitle}"/>
                <TextBlock Text="Vos plateformes sont configurées. L’émission n’a pas encore commencé." Style="{StaticResource TemhaloCaption}"/>
                <TextBlock Text="Réglages OBS renseignés" FontWeight="Medium"/>
                <TextBlock Text="Guide validé par vous. En attente de la connexion réelle d’OBS." Style="{StaticResource TemhaloCaption}"/>
              </StackPanel>
            </Border>
            <TextBlock Text="Au premier démarrage, Temhalo télécharge et vérifie les outils nécessaires automatiquement." Foreground="{ThemeResource TemhaloSecondaryBrush}"/>
            <local:SettingRow>
              <Button Content="Retour" Tag="2" Click="SetupStepClicked" HorizontalAlignment="Left"/>
              <local:WrapPanel Spacing="8">
                <Button x:Name="ActivateTemhalo" Content="Démarrer le relais" Click="StartStopClicked" Style="{StaticResource TemhaloPrimaryButton}"/>
                <Button x:Name="OpenDirect" Content="Revenir au Direct →" Click="OpenDirectClicked" Visibility="Collapsed"/>
              </local:WrapPanel>
            </local:SettingRow>
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="SettingsView" Visibility="Collapsed" Spacing="24">
          <StackPanel Spacing="8">
            <TextBlock Text="Réglages" Style="{StaticResource TemhaloTitle}" AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="L’essentiel pour garder Temhalo prêt à diffuser." Foreground="{ThemeResource TemhaloSecondaryBrush}"/>
          </StackPanel>
          <StackPanel Spacing="20">
            <local:SettingRow>
              <StackPanel Spacing="8">
                <TextBlock Text="Mises à jour" Style="{StaticResource TemhaloSectionTitle}"/>
                <TextBlock x:Name="InstalledVersionText" Foreground="{ThemeResource TemhaloSecondaryBrush}"/>
                <TextBlock x:Name="UpdateStatus" Text="Les nouvelles versions sont proposées depuis GitHub." Style="{StaticResource TemhaloCaption}" AutomationProperties.LiveSetting="Polite"/>
              </StackPanel>
              <local:WrapPanel Spacing="8">
                <Button x:Name="CheckUpdatesButton" Content="Rechercher une mise à jour" Click="CheckUpdatesClicked"/>
                <Button x:Name="DownloadUpdateButton" Content="Télécharger la mise à jour" Visibility="Collapsed" Click="DownloadUpdateClicked" Style="{StaticResource TemhaloPrimaryButton}"/>
                <Button x:Name="InstallUpdateButton" Content="Installer et fermer Temhalo" Visibility="Collapsed" Click="InstallUpdateClicked" Style="{StaticResource TemhaloPrimaryButton}"/>
                <Button x:Name="CancelUpdateButton" Content="Annuler" Visibility="Collapsed" Click="CancelUpdateClicked"/>
              </local:WrapPanel>
            </local:SettingRow>
            <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Minimum="0" Maximum="100" AutomationProperties.Name="Téléchargement de la mise à jour"/>
            <TextBlock x:Name="UpdateInstallHint" Style="{StaticResource TemhaloCaption}"/>
            <local:SettingRow>
              <TextBlock Text="Rechercher au démarrage"/>
              <ToggleSwitch x:Name="CheckUpdatesAtStartup" AutomationProperties.Name="Rechercher les mises à jour au démarrage" OnContent="Oui" OffContent="Non" Toggled="UpdatePreferencesChanged"/>
            </local:SettingRow>
            <local:SettingRow>
              <StackPanel Spacing="4">
                <TextBlock Text="Recevoir les versions de test"/>
                <TextBlock Text="Essayez les nouveautés avant leur sortie stable." Style="{StaticResource TemhaloCaption}"/>
              </StackPanel>
              <ToggleSwitch x:Name="IncludePreviewUpdates" AutomationProperties.Name="Recevoir les versions de test" OnContent="Oui" OffContent="Non" Toggled="UpdatePreferencesChanged"/>
            </local:SettingRow>
          </StackPanel>
          <Border Height="1" Background="{ThemeResource TemhaloRuleBrush}"/>
          <local:SettingRow>
            <StackPanel Spacing="8">
              <TextBlock Text="Stream Deck" Style="{StaticResource TemhaloSectionTitle}"/>
              <TextBlock x:Name="StreamDeckStatus" Text="Connexion automatique en préparation" Style="{StaticResource TemhaloCaption}" AutomationProperties.LiveSetting="Polite"/>
              <TextBlock Text="Réglez les valeurs de chaque touche dans l’application Stream Deck." Style="{StaticResource TemhaloCaption}"/>
            </StackPanel>
            <Button Content="Installer / mettre à jour le plugin" Click="InstallStreamDeckClicked"/>
          </local:SettingRow>
          <Expander x:Name="JournalExpander" Header="Options avancées et diagnostic" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="24">
              <local:AdaptiveColumns>
                <StackPanel Spacing="12">
                  <TextBlock Text="Mémoire du flux" Style="{StaticResource TemhaloSectionTitle}"/>
                  <NumberBox x:Name="MemoryLimit" Header="Limite en MiB" Value="512" Minimum="1" Maximum="4096" SpinButtonPlacementMode="Inline" Width="180" HorizontalAlignment="Left"/>
                  <TextBlock Text="512 MiB conviennent généralement à cinq minutes à 8 Mbit/s. Une alerte apparaît à 80 %. L’historique partage cette limite." Style="{StaticResource TemhaloCaption}"/>
                  <Button Content="Enregistrer la limite mémoire" Click="SaveMemoryClicked" HorizontalAlignment="Left"/>
                  <TextBlock x:Name="MemoryStatus" Style="{StaticResource TemhaloCaption}"/>
                </StackPanel>
                <StackPanel Spacing="12">
                  <TextBlock Text="État du flux" Style="{StaticResource TemhaloSectionTitle}"/>
                  <TextBlock Text="{x:Bind Vm.BufferText, Mode=OneWay}" Style="{StaticResource TemhaloMono}"/>
                  <ProgressBar x:Name="BufferBar" Value="{x:Bind Vm.BufferPercent, Mode=OneWay}" Maximum="100" Height="4"/>
                  <TextBlock Text="{x:Bind Vm.BufferHint, Mode=OneWay}" Style="{StaticResource TemhaloCaption}"/>
                  <TextBlock Text="Entrée OBS" Style="{StaticResource TemhaloCaption}"/>
                  <TextBlock Text="{x:Bind Vm.InputRate, Mode=OneWay}" Style="{StaticResource TemhaloMono}"/>
                  <TextBlock x:Name="OutputTitle" Text="Sorties" Style="{StaticResource TemhaloCaption}"/>
                  <TextBlock x:Name="OutputDetail" Text="RTMP / RTMPS · copie du flux" Style="{StaticResource TemhaloCaption}"/>
                  <TextBlock Text="{x:Bind Vm.OutputRate, Mode=OneWay}" Style="{StaticResource TemhaloMono}"/>
                  <TextBlock x:Name="OutputState" Text="{x:Bind Vm.OutputText, Mode=OneWay}" Style="{StaticResource TemhaloCaption}"/>
                  <TextBlock x:Name="ActiveOutputs" Visibility="Collapsed" Style="{StaticResource TemhaloCaption}"/>
                </StackPanel>
              </local:AdaptiveColumns>
              <local:AdaptiveColumns Columns="3">
                <StackPanel Spacing="6">
                  <TextBlock Text="Média en réserve" Style="{StaticResource TemhaloCaption}"/>
                  <TextBlock x:Name="ReserveValue" Style="{StaticResource TemhaloMono}"/>
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Text="Reconnexions" Style="{StaticResource TemhaloCaption}"/>
                  <TextBlock x:Name="ReconnectValue" Style="{StaticResource TemhaloMono}"/>
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Text="Média sauté" Style="{StaticResource TemhaloCaption}"/>
                  <TextBlock x:Name="SkippedValue" Style="{StaticResource TemhaloMono}"/>
                </StackPanel>
              </local:AdaptiveColumns>
              <Expander Header="Débit · 60 dernières secondes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <local:BitrateChart x:Name="RateChart"/>
              </Expander>
              <TextBlock x:Name="LastEvent" Style="{StaticResource TemhaloCaption}"/>
              <TextBlock Text="Journaux" Style="{StaticResource TemhaloSectionTitle}"/>
              <TextBlock Text="Les clés et les adresses de publication sont masquées." Style="{StaticResource TemhaloCaption}"/>
              <local:WrapPanel Spacing="8">
                <Button Content="Exporter le diagnostic" Click="ExportLogsClicked"/>
                <Button Content="Ouvrir les journaux" Click="OpenLogsClicked"/>
                <HyperlinkButton Content="Notes de version ↗" NavigateUri="https://github.com/Zeeroz/Temhalo/releases" Foreground="{ThemeResource TemhaloHaloBrush}"/>
              </local:WrapPanel>
              <ListView x:Name="JournalList" SelectionMode="None" MaxHeight="480" HorizontalContentAlignment="Stretch">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource TemhaloMono}" FontSize="12" TextWrapping="Wrap"/>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </StackPanel>
          </Expander>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
