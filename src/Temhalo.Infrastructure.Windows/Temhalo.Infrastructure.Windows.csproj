<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Description>Processus natifs, secrets DPAPI, raccourcis et services Windows.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Temhalo.Core\Temhalo.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="LocalWeb/Assets/*" LogicalName="Temhalo.LocalWeb.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../assets/brand/fonts/Inter-Variable.ttf" LogicalName="Temhalo.LocalWeb.Inter.ttf" />
    <EmbeddedResource Include="../../assets/brand/fonts/JetBrainsMono-Variable.ttf" LogicalName="Temhalo.LocalWeb.Mono.ttf" />
    <EmbeddedResource Include="../../assets/brand/fonts/SpaceGrotesk-Variable.ttf" LogicalName="Temhalo.LocalWeb.Space.ttf" />
  </ItemGroup>
</Project>
